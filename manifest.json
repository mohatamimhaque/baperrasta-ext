{
  "manifest_version": 3,
  "name": "Baper Rasta - Infinite Battery 100%",
  "version": "1.0.0",
  "description": "Always locks battPercent to 100%, provides infinite battery charge, and prevents pedal mode on baperrasta.com.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://baperrasta.com/*",
    "*://*.baperrasta.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://baperrasta.com/*",
        "*://*.baperrasta.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
